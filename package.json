{
  "name": "skillaudit",
  "version": "1.1.0",
  "description": "Security scanner for AI agent skills — scan SKILL.md files for threats, exfiltration, and malicious patterns",
  "main": "src/scanner.js",
  "bin": {
    "skillaudit": "bin/skillaudit.js"
  },
  "files": [
    "bin/",
    "src/scanner.js",
    "src/capabilities.js",
    "src/secrets.js",
    "rules/",
