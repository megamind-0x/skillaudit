  "repository": {
    "type": "git",
    "url": "https://github.com/megamind-0x/skillaudit"
  },
  "homepage": "https://skillaudit.vercel.app",
  "dependencies": {
    "@x402/evm": "^2.3.1",
    "@x402/express": "^2.3.0",
    "ethers": "^6.16.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.1"
  }
